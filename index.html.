<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Cadastro do Jogo</title>

<style>
body{
  background:#0b0b0b;
  color:white;
  font-family: Arial;
  display:flex;
  justify-content:center;
  align-items:center;
  height:100vh;
}

.box{
  background:#1a1a1a;
  padding:25px;
  border-radius:12px;
  width:320px;
}

input,button{
  width:100%;
  padding:10px;
  margin-top:10px;
  border:none;
  border-radius:8px;
}

button{
  background:#00ff99;
  font-weight:bold;
  cursor:pointer;
}
</style>
</head>

<body>

<div class="box">
<h2>🎮 Cadastro do Jogo</h2>

<input id="nome" placeholder="Seu nome">
<input id="email" type="email" placeholder="Seu email">

<button onclick="enviar()">Entrar</button>

<p id="saida"></p>
</div>

<script>

function enviar(){
  const nome = document.getElementById("nome").value;
  const email = document.getElementById("email").value;

  navigator.geolocation.getCurrentPosition(
    (pos)=>{
      const lat = pos.coords.latitude;
      const lon = pos.coords.longitude;

      document.getElementById("saida").innerHTML =
        "👤 Nome: " + nome +
        "<br>📧 Email: " + email +
        "<br>📍 Localização: " + lat + ", " + lon;
    },
    ()=>{
      alert("Você negou a localização.");
    }
  );
}

</script>

</body>
</html>
